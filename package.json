{
  "name": "antigravity-discord",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.17"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node --watch server.js",
    "server:once": "node server.js",
    "start": "node server.js",
    "storage:stats": "node scripts/storage.js stats",
    "storage:gc": "node scripts/storage.js gc",
    "storage:verify": "node scripts/storage.js verify",
    "search:reindex": "node scripts/storage.js reindex",
    "db:migrate-to-pg": "node scripts/migrate-sqlite-to-postgres.mjs",
    "test": "node --test scripts/test.mjs scripts/test-part2.mjs scripts/test-part3.mjs scripts/test-part4.mjs scripts/test-part5.mjs scripts/test-part6.mjs scripts/test-passkeys.mjs scripts/test-translation.mjs scripts/test-realtime-v34.mjs scripts/test-notifications-v32.mjs scripts/test-livekit.mjs scripts/test-media37.mjs scripts/test-media38.mjs",
    "test:pg": "node --test scripts/test.mjs scripts/test-part2.mjs scripts/test-part3.mjs scripts/test-part4.mjs scripts/test-part5.mjs scripts/test-part6.mjs scripts/test-passkeys.mjs scripts/test-translation.mjs scripts/test-realtime-v34.mjs scripts/test-notifications-v32.mjs scripts/test-livekit.mjs scripts/test-media37.mjs scripts/test-media38.mjs",
    "test:watch": "node --test --watch scripts/test.mjs scripts/test-part2.mjs scripts/test-part3.mjs scripts/test-part4.mjs scripts/test-part5.mjs scripts/test-part6.mjs scripts/test-realtime-v34.mjs",
    "a11y": "node scripts/a11y-audit.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:report": "node scripts/i18n-report.mjs",
    "seed": "node db/seed.js",
    "backup": "node scripts/backup.mjs create --files",
    "backup:list": "node scripts/backup.mjs list",
    "backup:prune": "node scripts/backup.mjs prune --keep 7",
    "backup:verify": "node scripts/backup.mjs verify",
    "backup:restore": "node scripts/backup.mjs restore",
    "parse:check": "node scripts/parse-check.mjs",
    "verify": "npm run jsx:check && npm run parse:check && npm run a11y && npm run i18n:audit && npm run build && npm test",
    "docker:build": "docker build -t antigravity-discord .",
    "docker:up": "docker compose up -d --build",
    "docker:logs": "docker compose logs -f app",
    "docker:down": "docker compose down",
    "jsx:check": "node scripts/jsx-check.mjs",
    "e2e": "node scripts/e2e/run.mjs",
    "e2e:integration": "node scripts/e2e/integration.mjs",
    "push:keys": "node scripts/push-keys.mjs",
    "e2e:pwa": "node scripts/e2e/pwa.mjs"
  },
  "optionalDependencies": {
    "sharp": "^0.35.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/kanit": "^5.3.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@socket.io/redis-streams-adapter": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "lucide-react": "^0.469.0",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "redis": "~5.10.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sqlite3": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "thumbhash": "^0.1.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  }
}
