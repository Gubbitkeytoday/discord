# ============================================================================
#  Reverse proxy for Antigravity Discord.
#
#  Caddy is used instead of nginx for one reason: it obtains and renews the TLS
#  certificate on its own. Everything below is otherwise deliberately plain —
#  one upstream, correct forwarded headers, and no buffering that would break
#  WebSockets or uploads.
# ============================================================================

{$DOMAIN} {
	encode zstd gzip

	# Upper bound on a request body. The app's own per-category limits are far
	# lower (attachments: 10 files x 50 MB); this only stops an unbounded body
	# from being streamed at the process, which buffers uploads in memory.
	request_body {
		max_size 520MB
	}

	# Socket.IO upgrades on this path. Caddy proxies WebSockets natively, so no
	# special upgrade block is needed — but it must not be compressed or
	# buffered, hence the separate matcher with its own handler.
	@websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @websocket {
		reverse_proxy app:3001
	}

	# Uploaded files: long-lived, content-addressed, safe to cache at the edge.
	# The app already sets a restrictive CSP and Content-Disposition on these.
	handle /uploads/* {
		reverse_proxy app:3001
	}

	# The metrics endpoint must never be public. Remove this block if Prometheus
	# scrapes it over the internal network only (the usual arrangement).
	handle /metrics {
		respond 404
	}

	handle {
		reverse_proxy app:3001 {
			# Uploads can be large and slow; do not cut them off early.
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
			health_uri /api/live
			health_interval 15s
			health_timeout 5s
		}
	}

	header {
		# HSTS belongs at the edge, where TLS actually terminates. Add
		# `; includeSubDomains; preload` only once every subdomain of this
		# domain serves HTTPS: preload is hard to undo and breaks any that don't.
		Strict-Transport-Security "max-age=63072000"
		-Server
	}

	log {
		output stdout
		format json
	}
}

# ============================================================================
#  LiveKit SFU signalling (optional — `docker compose --profile livekit`).
#
#  Uncomment once LIVEKIT_DOMAIN in .env points at this host (compose passes
#  it to this container). It is commented out so a stack without LiveKit does not request a
#  certificate for a domain that does not exist. Only signalling (WebSocket)
#  goes through Caddy; media uses 7882/udp, 7881/tcp and 3479/udp directly —
#  see DEPLOYMENT.md, section 4b.
# ============================================================================

# {$LIVEKIT_DOMAIN} {
# 	reverse_proxy livekit:7880 {
# 		# Signalling sockets live as long as the call.
# 		transport http {
# 			read_timeout 0
# 		}
# 	}
# 	log {
# 		output stdout
# 		format json
# 	}
# }
