# Anything not needed to build or run the image. Keeping this tight matters:
# every extra file is build context uploaded on each `docker build`.
node_modules
dist
.git
.gitignore
.env
.env.*
!.env.example

# Local database and uploaded files — these belong on a volume, never baked in.
*.db
*.db-shm
*.db-wal
public/uploads
backups

# Development-only material.
scripts/themeify*.mjs
scripts/i18n-remaining.mjs
*.log
npm-debug.log*
coverage
.vscode
.idea
.DS_Store
Thumbs.db
