# ============================================================================
#  Antigravity Discord — configuration
#
#  Copy to .env and edit. The values below are the DEVELOPMENT defaults; the
#  "production" notes on each block say what has to change. lib/config.js refuses
#  to start with NODE_ENV=production and an insecure combination, so a mistake
#  here fails at boot rather than silently in the wild.
# ============================================================================

# --- runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Absolute, externally visible URL. Used in invite links, e-mails and the CSP.
# Production: your real https:// origin.
PUBLIC_URL=http://localhost:5173

# How many reverse proxies sit in front of this process. Behind exactly one
# (nginx, Caddy, a cloud load balancer) use 1. Trusting more hops than you
# actually have lets a client forge its own IP and escape rate limiting.
# 'loopback' is the development default.
TRUST_PROXY=loopback

# Comma-separated allow-list. Leave EMPTY in production when this process also
# serves the SPA — the client is then same-origin and needs no CORS at all.
# '*' is refused in production.
CORS_ORIGIN=http://localhost:5173

# --- serving the built client -------------------------------------------------
# On in production: one process, one port, no separate web server.
# In development the Vite dev server handles this instead.
SERVE_STATIC=0
STATIC_DIR=dist

# --- database ----------------------------------------------------------------
# Two engines, one code path:
#   * DATABASE_URL unset          → SQLite file at DB_PATH (zero-config, one
#                                   process, fine for small communities)
#   * DATABASE_URL=postgres://…   → PostgreSQL 13+ (recommended for production:
#                                   concurrent writers, pg_dump backups,
#                                   several app instances if you add a shared
#                                   socket adapter — see DEPLOYMENT.md)
# The schema is created and migrated automatically on boot either way.
# Moving an existing SQLite database over: npm run db:migrate-to-pg.
DB_PATH=./discord.db
# DATABASE_URL=postgres://antigravity:change-me@localhost:5432/antigravity
#
# TLS to the database. disable | require (encrypt, don't verify) |
# verify-full (encrypt and verify; add DATABASE_SSL_CA for a private CA).
# An ?sslmode= in DATABASE_URL works too; this variable wins when both are set.
# DATABASE_SSL=verify-full
# DATABASE_SSL_CA=/etc/ssl/certs/rds-ca.pem
#
# Connection pool, per app process. Keep DB_POOL_MAX × instances below the
# server's max_connections (minus superuser_reserved_connections).
# DB_POOL_MAX=10
# DB_POOL_IDLE_MS=30000
# DB_CONNECT_TIMEOUT_MS=10000
# Server-side limits applied to every connection (milliseconds).
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_LOCK_TIMEOUT_MS=10000
# DB_IDLE_IN_TX_TIMEOUT_MS=60000
# Transactions run SERIALIZABLE and are retried on serialization failures /
# deadlocks this many times. Leave the isolation alone unless you know why.
# DB_TX_ISOLATION=serializable
# DB_TX_RETRIES=8
# DB_APPLICATION_NAME=antigravity-discord
#
# SQL_DEBUG=1   (SQLite only: verbose driver stack traces)

# --- file storage ------------------------------------------------------------
STORAGE_ROOT=./public/uploads
STORAGE_PUBLIC_BASE=/uploads

# Signs private-file URLs. MUST be replaced in production — with the value
# below, anyone who has read this repository can forge a link to any file.
#   openssl rand -base64 32
STORAGE_URL_SECRET=dev-insecure-storage-secret

# Required to enable /api/files/maintenance/* (GC, integrity check) and report
# triage. Generate the same way as above.
# ADMIN_TOKEN=

# --- authentication ----------------------------------------------------------
# The x-user-id shortcut: any request can claim to be any user. Development only
# — production refuses to start unless this is 0.
ALLOW_DEV_IDENTITY=1

# Adds the Secure flag to session cookies. Turn on as soon as TLS terminates in
# front of this server.
SECURE_COOKIES=0

# Session lifetime (absolute, from sign-in) and idle limit, in days.
# SESSION_TTL_DAYS=30
# SESSION_IDLE_DAYS=14

# --- mail (password reset, e-mail verification) -------------------------------
# console (default, logs only) | file | smtp
# Production with `console` (or unset): password reset and e-mail verification
# are switched off (503 MAIL_NOT_CONFIGURED) — configure SMTP to enable them.
# Reset/verification tokens are only ever echoed in API responses in
# development with the console transport.
MAIL_TRANSPORT=console
MAIL_FROM="Antigravity Discord <no-reply@antigravity.local>"
# MAIL_FILE=mail.log
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- object storage ----------------------------------------------------------
# Leave unset to keep files on local disk. Any S3-compatible endpoint works
# (AWS S3, Cloudflare R2, Backblaze B2, MinIO) — the signer is SigV4.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=antigravity-media
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=1

# --- voice -------------------------------------------------------------------
# Full-mesh participant cap. Beyond this an SFU is required: every extra peer
# costs each participant another upstream, so the mesh stops scaling.
VOICE_MESH_LIMIT=8

# --- internationalisation ----------------------------------------------------
# Fallback only. The client prefers the visitor's own browser languages and
# remembers an explicit choice. Available: en, th
DEFAULT_LOCALE=en

# --- observability -----------------------------------------------------------
# pretty (human, development) | json (one object per line, for a log aggregator)
LOG_FORMAT=pretty
# error | warn | info | debug
LOG_LEVEL=debug

# Prometheus text exposition at /metrics, behind `Authorization: Bearer <token>`.
# In production the endpoint exists only when METRICS_TOKEN is set; in
# development it is open when no token is set.
ENABLE_METRICS=1
# METRICS_TOKEN=

# --- images ------------------------------------------------------------------
# Remote images (avatars, icons, link previews) are served through the
# same-origin proxy /api/media/proxy?url=…, and the CSP allows images from
# 'self' only. Add origins here if you serve uploads from a CDN that is not
# STORAGE_PUBLIC_BASE (comma-separated).
# CSP_IMG_SOURCES=https://cdn.example.com
# MEDIA_PROXY_MAX_BYTES=8388608
# MEDIA_PROXY_CACHE_BYTES=67108864

# How long SIGTERM waits for in-flight requests before forcing exit.
SHUTDOWN_TIMEOUT_MS=15000

# --- docker compose ----------------------------------------------------------
# Domain Caddy requests a certificate for. Use `localhost` for a local
# self-signed cert instead of a public ACME one.
DOMAIN=localhost
# The compose file runs PostgreSQL and points the app at it. Set a real
# password before the first `docker compose up` (it is baked into the volume
# on first start). To stay on SQLite under compose instead, set
# DATABASE_URL= (empty) in .env and drop the postgres service.
POSTGRES_PASSWORD=change-me-too

# --- seed data -----------------------------------------------------------------
# Development databases are seeded with demo accounts that all share the
# password in db/seed.js. Production never seeds unless this is set to 1 —
# leave it unset there, or anyone can sign in as the seeded server owner.
# SEED_DATABASE=0

# --- voice / video (WebRTC) -----------------------------------------------------
# Served to signed-in clients by GET /api/voice/ice-servers.
# STUN servers, comma-separated.
# STUN_URLS=stun:stun.l.google.com:19302
# TURN relay (coturn with use-auth-secret / static-auth-secret). When both are
# set, each client gets short-lived REST credentials derived from the secret;
# the secret itself never leaves the server.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=
# Lifetime of issued TURN credentials, in seconds.
# TURN_TTL_SECONDS=86400
# 'relay' forces all media through TURN (hides client IPs); default 'all'.
# ICE_TRANSPORT_POLICY=all

# --- backups -------------------------------------------------------------------
# Where database/file backup snapshots are written (backup tooling).
# BACKUP_DIR=./backups

# --- observability ---------------------------------------------------------------
# Everything here is optional and off by default. See DEPLOYMENT.md,
# "Observability". LOG_LEVEL accepts trace|debug|info|warn|error|fatal|silent.
#
# OpenTelemetry traces + metrics + logs over OTLP/HTTP. Unset = the SDK is not
# even loaded. Needs the preload (the Docker image always uses it):
#   NODE_OPTIONS="--import ./lib/otel-preload.mjs" npm start
# With the compose `observability` profile: http://lgtm:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=antigravity-discord
# Sample 10% of new traces in production (parent decisions are respected).
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_LOGS_EXPORTER=none            # keep logs on stdout only
#
# Grafana admin password for the compose `observability` profile.
# GRAFANA_ADMIN_PASSWORD=
#
# Error tracking (Sentry protocol: self-hosted GlitchTip or Sentry). Server
# errors (5xx, crashes) are sent with PII scrubbed. SENTRY_BROWSER_DSN is
# public by design (it ships to browsers); use a separate project for it.
# Browser reports are tunnelled through /api/telemetry/errors.
# SENTRY_DSN=
# SENTRY_BROWSER_DSN=
# SENTRY_ENVIRONMENT=production
# Release tag for error reports; the Docker image sets it to the git sha.
# APP_RELEASE=
#
# Core Web Vitals from browsers (anonymous; name/value/rating only).
# WEB_VITALS_ENABLED=1
# WEB_VITALS_SAMPLE_RATE=0.25
# RATE_LIMIT_VITALS_PER_MIN=30
#
# Readiness (/api/ready): 503 below this much free disk where uploads or the
# SQLite file live; "low" (still ready) below the warn level.
# READY_DISK_MIN_FREE_MB=256
# READY_DISK_WARN_FREE_MB=1024
# When set, /api/ready also PINGs Redis/Valkey (redis:// or rediss://).
# REDIS_URL=
