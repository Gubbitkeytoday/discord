# ============================================================================
#  Antigravity Discord — configuration
#
#  Copy to .env and edit. The values below are the DEVELOPMENT defaults; the
#  "production" notes on each block say what has to change. lib/config.js refuses
#  to start with NODE_ENV=production and an insecure combination, so a mistake
#  here fails at boot rather than silently in the wild.
#
#  Secrets: `npm run secrets` prints fresh values for every secret below
#  (STORAGE_URL_SECRET, ADMIN_TOKEN, METRICS_TOKEN, POSTGRES_PASSWORD,
#  TURN_SECRET, LIVEKIT_API_SECRET, VAPID keys) ready to paste into .env.
#  `npm run secrets -- --write` appends the missing ones to .env for you.
#
#  Every variable the code reads is listed here (active or commented out);
#  DEPLOYMENT.md "Environment reference" is generated from this file.
# ============================================================================

# --- runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Absolute, externally visible URL. Used in invite links, e-mails and the CSP.
# Production: your real https:// origin.
PUBLIC_URL=http://localhost:5173

# How many reverse proxies sit in front of this process. Behind exactly one
# (nginx, Caddy, a cloud load balancer) use 1. Trusting more hops than you
# actually have lets a client forge its own IP and escape rate limiting.
# 'loopback' is the development default; production defaults to 1. Compose
# `no-proxy` profile behind a NAS reverse proxy: 2.
TRUST_PROXY=loopback

# Comma-separated allow-list. Leave EMPTY in production when this process also
# serves the SPA — the client is then same-origin and needs no CORS at all.
# '*' is refused in production.
CORS_ORIGIN=http://localhost:5173

# --- serving the built client -------------------------------------------------
# On in production: one process, one port, no separate web server.
# In development the Vite dev server handles this instead.
SERVE_STATIC=0
STATIC_DIR=dist

# --- database ----------------------------------------------------------------
# Two engines, one code path:
#   * DATABASE_URL unset          → SQLite file at DB_PATH (zero-config, one
#                                   process, fine for small communities)
#   * DATABASE_URL=postgres://…   → PostgreSQL 13+ (recommended for production:
#                                   concurrent writers, pg_dump backups,
#                                   several app instances if you add a shared
#                                   socket adapter — see DEPLOYMENT.md)
# The schema is created and migrated automatically on boot either way.
# Moving an existing SQLite database over: npm run db:migrate-to-pg.
DB_PATH=./discord.db
# DATABASE_URL=postgres://antigravity:change-me@localhost:5432/antigravity
#
# TLS to the database. disable | require (encrypt, don't verify) |
# verify-full (encrypt and verify; add DATABASE_SSL_CA for a private CA).
# An ?sslmode= in DATABASE_URL works too; this variable wins when both are set.
# DATABASE_SSL=verify-full
# DATABASE_SSL_CA=/etc/ssl/certs/rds-ca.pem
#
# Connection pool, per app process. Keep DB_POOL_MAX × instances below the
# server's max_connections (minus superuser_reserved_connections).
# DB_POOL_MAX=10
# DB_POOL_MIN=0
# DB_POOL_IDLE_MS=30000
# DB_CONNECT_TIMEOUT_MS=10000
# Server-side limits applied to every connection (milliseconds).
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_LOCK_TIMEOUT_MS=10000
# DB_IDLE_IN_TX_TIMEOUT_MS=60000
# Transactions run SERIALIZABLE and are retried on serialization failures /
# deadlocks this many times. Leave the isolation alone unless you know why.
# DB_TX_ISOLATION=serializable
# DB_TX_RETRIES=8
# DB_APPLICATION_NAME=antigravity-discord
#
# SQL_DEBUG=1   (SQLite only: verbose driver stack traces)

# --- file storage ------------------------------------------------------------
STORAGE_ROOT=./public/uploads
STORAGE_PUBLIC_BASE=/uploads

# Signs private-file URLs. MUST be replaced in production — with the value
# below, anyone who has read this repository can forge a link to any file.
#   openssl rand -base64 32
STORAGE_URL_SECRET=dev-insecure-storage-secret

# Required to enable /api/files/maintenance/* (GC, integrity check) and report
# triage. Generate the same way as above.
# ADMIN_TOKEN=

# --- authentication ----------------------------------------------------------
# The x-user-id shortcut: any request can claim to be any user. Development only
# — production refuses to start unless this is 0.
ALLOW_DEV_IDENTITY=1

# Adds the Secure flag to session cookies. Default: on in production.
# Browsers DROP Secure cookies on plain http:// (except localhost), so with this
# on, opening the server as http://192.168.x.x signs everyone straight back out
# (the server prints a red CONFIGURATION PROBLEM box at boot when PUBLIC_URL
# is http:// and not localhost). Testing on a LAN without TLS: SECURE_COOKIES=0
# and PUBLIC_URL=http://<lan-ip>:3001. Never run it that way on the internet.
SECURE_COOKIES=0

# Session lifetime (absolute, from sign-in) and idle limit, in days.
# SESSION_TTL_DAYS=30
# SESSION_IDLE_DAYS=14

# --- mail (password reset, e-mail verification) -------------------------------
# console (default, logs only) | file | smtp
# Production with `console` (or unset): password reset and e-mail verification
# are switched off (503 MAIL_NOT_CONFIGURED) — configure SMTP to enable them.
# Reset/verification tokens are only ever echoed in API responses in
# development with the console transport.
MAIL_TRANSPORT=console
MAIL_FROM="Antigravity Discord <no-reply@antigravity.local>"
# MAIL_FILE=mail.log
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# Name sent in EHLO (some relays reject "localhost").
# SMTP_EHLO=chat.example.com

# --- object storage ----------------------------------------------------------
# Leave unset to keep files on local disk. Any S3-compatible endpoint works
# (AWS S3, Cloudflare R2, Backblaze B2, MinIO) — the signer is SigV4.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=antigravity-media
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Temporary credentials (STS) only.
# S3_SESSION_TOKEN=
# S3_FORCE_PATH_STYLE=1
# Browser → bucket uploads (POST /api/media/uploads). post = presigned POST
# policy (S3, MinIO, B2); put = presigned PUT (Cloudflare R2 has no POST
# Object — picked automatically for *.r2.cloudflarestorage.com); off = disabled.
# The bucket needs CORS allowing POST/PUT from your origin, and the CSP
# connect-src must allow the bucket origin (see DEPLOYMENT.md §7).
# S3_DIRECT_UPLOAD=post
# Serve public objects straight from a CDN / public bucket URL. Unset, public
# files are redirected to short-lived presigned URLs via /uploads/<key>.
# STORAGE_PUBLIC_BASE=https://cdn.example.com

# --- media pipeline ----------------------------------------------------------
# Images: EXIF/GPS stripped, WebP renditions at MEDIA_WIDTHS, AVIF in the
# background (effort 2: ~1.4 s for a 1920px rendition on one core; sharp's
# default effort 4 is ~9 s). Videos: poster + probe via system ffmpeg.
# MEDIA_WIDTHS=160,480,960,1920
# MEDIA_AVIF=1
# MEDIA_AVIF_EFFORT=2
# MEDIA_AVIF_QUALITY=50
# MEDIA_WEBP_QUALITY=78
# Decompression-bomb limits, checked from the header before any decode.
# MEDIA_MAX_PIXELS=100000000
# MEDIA_MAX_DIMENSION=16384
# MEDIA_MAX_ANIMATED_PIXELS=200000000
# How long a multipart upload waits for its renditions before answering
# 'processing' (0 = answer at once; dimensions + thumbhash are always included).
# MEDIA_SYNC_BUDGET_MS=0
# Background jobs processed at once by this process.
# MEDIA_JOB_CONCURRENCY=2
# ffmpeg/ffprobe for video posters, dimensions and duration (optional).
# MEDIA_FFMPEG=1
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# Per-user storage quota in bytes for everyone (0 = unlimited). Unset, the
# per-user users.storage_quota column (default 5 GiB) applies.
# STORAGE_QUOTA_BYTES=

# --- voice -------------------------------------------------------------------
# Full-mesh participant cap. Beyond this an SFU is required: every extra peer
# costs each participant another upstream, so the mesh stops scaling.
VOICE_MESH_LIMIT=8

# --- internationalisation ----------------------------------------------------
# The client picks the UI language from the visitor's browser languages and
# remembers an explicit choice; it falls back to English. 32 locales ship
# (Discord's set: en-US, en-GB, th, ja, zh-CN, zh-TW, ko, de, fr, es-ES,
# es-419, pt-BR, …; full list in src/i18n/locales/_registry.js).
# DEFAULT_LOCALE is read by lib/config.js but not yet used by the client.
DEFAULT_LOCALE=en

# --- observability -----------------------------------------------------------
# pretty (human, development) | json (one object per line, for a log aggregator).
# Default: json in production, pretty otherwise. Compose forces json.
LOG_FORMAT=pretty
# error | warn | info | debug. Default: info in production, debug otherwise —
# left unset here so a copied .env does not put production on debug.
# LOG_LEVEL=info

# Prometheus text exposition at /metrics, behind `Authorization: Bearer <token>`.
# In production the endpoint exists only when METRICS_TOKEN is set; in
# development it is open when no token is set.
ENABLE_METRICS=1
# METRICS_TOKEN=

# --- images ------------------------------------------------------------------
# Remote images (avatars, icons, link previews) are served through the
# same-origin proxy /api/media/proxy?url=…, and the CSP allows images from
# 'self' only. Add origins here if you serve uploads from a CDN that is not
# STORAGE_PUBLIC_BASE (comma-separated).
# CSP_IMG_SOURCES=https://cdn.example.com
# MEDIA_PROXY_MAX_BYTES=8388608
# MEDIA_PROXY_CACHE_BYTES=67108864

# How long SIGTERM waits for in-flight requests before forcing exit.
SHUTDOWN_TIMEOUT_MS=15000

# --- static client (SERVE_STATIC=1) ------------------------------------------
# JS/CSS/HTML/SVG are compressed (brotli, else gzip) once per build and kept
# in memory, for installs without a compressing proxy in front. 0 = off.
# STATIC_COMPRESS=1
# STATIC_COMPRESS_CACHE_BYTES=33554432

# --- docker compose ----------------------------------------------------------
# Domain Caddy requests a certificate for. Use `localhost` for a local
# self-signed cert instead of a public ACME one. Dynamic DNS works too, e.g.
# DOMAIN=mychat.synology.me (DSM › External Access › DDNS).
DOMAIN=localhost
# REQUIRED for docker compose — deliberately empty, so `docker compose up`
# refuses to start until you set one ("set POSTGRES_PASSWORD in .env").
# URL-safe characters only (it is spliced into DATABASE_URL): `npm run secrets`
# prints one. Baked into the database volume on the very first start. To stay
# on SQLite under compose instead, set DATABASE_URL= (empty).
POSTGRES_PASSWORD=
# Host ports Caddy publishes. Change them when something else already owns
# 80/443 (a Synology/QNAP NAS) and forward the router's 80/443 to these.
# HTTP_PORT=80
# HTTPS_PORT=443
# `no-proxy` profile (docker compose --profile no-proxy up -d app-direct):
# the app on plain HTTP at APP_BIND:APP_PORT, no Caddy. 127.0.0.1 = reachable
# only by a reverse proxy on the same host (DSM); 0.0.0.0 = the whole LAN.
# APP_BIND=127.0.0.1
# APP_PORT=3001

# --- seed data -----------------------------------------------------------------
# Development databases are seeded with demo accounts that all share the
# password in db/seed.js. Production never seeds unless this is set to 1 —
# leave it unset there, or anyone can sign in as the seeded server owner.
# `npm run seed` (node db/seed.js) follows the same rule: refused in production
# unless SEED_DATABASE=1, and a no-op on a database that already has users.
# SEED_DATABASE=0

# --- voice / video (WebRTC) -----------------------------------------------------
# Served to signed-in clients by GET /api/voice/ice-servers.
# STUN servers, comma-separated. Unset = Google's public STUN, which means every
# caller's IP address is sent to Google. With the compose `turn` profile,
# coturn answers STUN too: STUN_URLS=stun:chat.example.com:3478
# STUN_URLS=stun:stun.l.google.com:19302
# TURN relay (coturn with use-auth-secret / static-auth-secret). When both are
# set, each client gets short-lived REST credentials derived from the secret;
# the secret itself never leaves the server. The compose coturn has no TLS
# certificate, so list turn: (UDP and TCP) only, not turns:.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# TURN_SECRET=
# compose `turn` profile: public IP, or public/private when the host is behind
# NAT (cloud VM *or* a home/office router in front of a NAS).
# TURN_EXTERNAL_IP=203.0.113.10/192.168.1.20
# Lifetime of issued TURN credentials, in seconds.
# TURN_TTL_SECONDS=86400
# 'relay' forces all media through TURN (hides client IPs); default 'all'.
# ICE_TRANSPORT_POLICY=all

# --- voice / video: LiveKit SFU (optional) ---------------------------------------
# When LIVEKIT_URL, LIVEKIT_API_KEY and LIVEKIT_API_SECRET are all set, voice,
# video, screen share and stage channels use the LiveKit SFU instead of the
# peer-to-peer mesh (no VOICE_MESH_LIMIT, simulcast, adaptive stream). Leave
# them unset to keep the mesh. GET /api/voice/config tells clients which.
# Compose: `docker compose --profile livekit up -d` + DEPLOYMENT.md.
#
# Public WebSocket URL browsers connect to (TLS in production).
# LIVEKIT_URL=wss://lk.example.com
# Key name and secret (secret: 32+ chars, `openssl rand -hex 32`). The compose
# profile passes these to the LiveKit container; livekit.yaml's
# webhook.api_key must equal the key name.
# LIVEKIT_API_KEY=antigravity
# LIVEKIT_API_SECRET=
# Server API URL the app calls (moderation, permissions). Defaults to
# LIVEKIT_URL with ws→http; inside compose use the internal address.
# LIVEKIT_HOST=http://livekit:7880
# Hostname Caddy serves LiveKit signalling on (see Caddyfile).
# LIVEKIT_DOMAIN=lk.example.com
# Room token lifetime (60–3600 s). LiveKit refreshes tokens of connected
# participants itself, so this only bounds how long an unused token is valid.
# LIVEKIT_TOKEN_TTL_SECONDS=600
# Cap per room on top of each channel's own user limit; 0 = none.
# LIVEKIT_ROOM_LIMIT=0
# Preferred camera/screen codec: auto (AV1 → VP9 → VP8 by browser support,
# always with a VP8 backup layer), vp8, vp9, av1, h264.
# LIVEKIT_VIDEO_CODEC=auto
# Media encryption with a per-room key derived from LIVEKIT_E2EE_SECRET (or the
# API secret). Protects media from the SFU operator, not from this app server.
# LIVEKIT_E2EE=0
# LIVEKIT_E2EE_SECRET=

# --- backups -------------------------------------------------------------------
# Where database/file backup snapshots are written (backup tooling).
# BACKUP_DIR=./backups
# PostgreSQL client binaries for scripts/backup.mjs (default: from PATH). Must
# be the server's major version or newer. In Docker use
# scripts/ops/docker-backup.sh instead: it runs pg_dump in the postgres container.
# PG_DUMP=/usr/lib/postgresql/16/bin/pg_dump
# PG_RESTORE=/usr/lib/postgresql/16/bin/pg_restore

# --- realtime scale-out (optional) ---------------------------------------------
# Unset = single instance, everything in memory (the default). Set to run
# several app instances behind one proxy: Socket.IO Redis Streams adapter
# (cross-instance fan-out + connection-state recovery across instances),
# shared rate limits, presence with TTL heartbeats. Valkey or Redis >= 6.2.
# Requires PostgreSQL. See DEPLOYMENT.md §8 "Running several instances".
# REDIS_URL=redis://valkey:6379
# Key prefix, so one Valkey can serve several deployments.
# REDIS_KEY_PREFIX=ag:
# First connection attempt (ms). A configured but unreachable Redis fails boot.
# REDIS_CONNECT_TIMEOUT_MS=5000
# Per-command timeout (ms). A Redis that stops answering (paused, overloaded,
# black-holed network) trips a breaker: rate limits and presence fall back to
# this instance's memory until a PING (every REDIS_STALL_PROBE_MS) answers.
# REDIS_COMMAND_TIMEOUT_MS=500
# REDIS_STALL_PROBE_MS=1000
# compose `scale` profile: two sticky upstreams instead of one.
# CADDYFILE=./Caddyfile.scale
# Each instance needs a distinct snowflake worker id (0-31); compose sets it.
# WORKER_ID=0
# How long a dropped client may resume with its missed events (ms; 0 = off).
# SOCKET_RECOVERY_MS=120000
# Largest single socket frame accepted (bytes). Files go over HTTP.
# SOCKET_MAX_PAYLOAD_BYTES=524288
# Presence heartbeat TTL on a cluster: a crashed instance's users go offline
# after roughly this long (ms).
# PRESENCE_TTL_MS=90000
# Replay history kept in the Redis stream (entries, approximate).
# SOCKET_STREAM_MAXLEN=20000
# Offline is announced only after this long without any connection (ms).
# PRESENCE_OFFLINE_GRACE_MS=5000
# Resolved-session cache (ms); default 30000 in production, 0 elsewhere.
# SESSION_CACHE_TTL_MS=30000
# SESSION_TOUCH_INTERVAL_MS=300000
# Message write admission: in flight / waiting / longest wait (ms).
# MESSAGE_WRITE_CONCURRENCY=32
# MESSAGE_WRITE_QUEUE=256
# MESSAGE_WRITE_MAX_WAIT_MS=5000
# libuv pool (scrypt + sqlite3 + fs); default max(16, 2 x cores).
# UV_THREADPOOL_SIZE=16
# Rate limits (per user unless noted).
# RATE_LIMIT_READ_PER_MIN=600
# RATE_LIMIT_MUTATE_PER_MIN=600
# RATE_LIMIT_UPLOAD_PER_MIN=30
# RATE_LIMIT_LOGIN_PER_5MIN=10        # per IP + username
# RATE_LIMIT_LOGIN_IP_PER_5MIN=60     # per IP
# RATE_LIMIT_WRITE_PER_MIN=60         # message sends / edits over HTTP
# RATE_LIMIT_REGISTER_PER_HOUR=20     # new accounts per IP (no invite)
# RATE_LIMIT_REGISTER_INVITE_PER_HOUR=100  # sign-ups carrying a valid invite (schools, clubs on one Wi-Fi)
# Socket flood guard: multiply every per-event budget (load tests only).
# SOCKET_FLOOD_MULTIPLIER=1
# Guilds whose permission data is cached in memory (LRU).
# PERM_CACHE_GUILDS=2000
# --- safety & instance administration ----------------------------------------------
# Who may create accounts: open | invite (valid invite required) | closed.
# Instance admins can override this at runtime in the admin console.
# REGISTRATION_MODE=open
# Comma-separated e-mails that are instance admins once verified (the first
# account on a fresh instance is admin automatically).
# ADMIN_EMAILS=
# Require a date of birth at sign-up (year + month only are stored; under-13
# is refused, under-18 gets teen-safe defaults).
# REQUIRE_BIRTHDATE=0

# --- passkeys (WebAuthn) ---------------------------------------------------------
# Off unless PASSKEYS_ENABLED=1, RP_ID or PUBLIC_URL is set (PASSKEYS_ENABLED=0
# always wins). RP_ID is the registrable domain passkeys are bound to — changing
# it later orphans every registered passkey. Both default from PUBLIC_URL.
# PASSKEYS_ENABLED=1
# RP_ID=chat.example.com
# Allowed page origins, comma-separated (add the Vite dev origin in development:
# RP_ORIGIN=http://localhost:5173).
# RP_ORIGIN=https://chat.example.com
# RP_NAME=Antigravity Discord

# --- message translation -----------------------------------------------------------
# Browsers with the built-in Translator API translate on-device and need none of
# this. Server-side providers are tried in order; unset = not used.
# Self-hosted LibreTranslate (docker compose --profile translate up -d):
# LIBRETRANSLATE_URL=http://libretranslate:5000
# LIBRETRANSLATE_API_KEY=
# compose `translate` profile: languages to download (each is a model of a few
# hundred MB) and LibreTranslate's own API-key switch (then set the key above).
# LT_LOAD_ONLY=en,th,ja,zh,zt,ko,es,fr,de,pt,ru,vi,id
# LT_API_KEYS=false
# DEEPL_API_KEY=            # keys ending in :fx use the free API host
# DEEPL_API_URL=            # override the DeepL host (proxy / regional endpoint)
# ANTHROPIC_API_KEY=        # Claude as a last resort
# TRANSLATION_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Order / subset of providers:
# TRANSLATION_PROVIDERS=libretranslate,deepl,anthropic
# TRANSLATION_SERVER_ENABLED=1      # 0 turns off /api/translate entirely
# TRANSLATION_CLIENT_ENABLED=1      # 0 hides on-device translation too
# TRANSLATION_CACHE_TTL_HOURS=168
# TRANSLATION_RATE_PER_MIN=20       # provider calls (cache misses) per user
# TRANSLATION_REQUESTS_PER_MIN=120  # all translate requests per user

# --- Web Push / PWA notifications (services/push.js) -------------------------------
# Off unless all three VAPID values are set. Generate once: npm run push:keys
# Rotating the key pair invalidates every browser subscription (they re-subscribe
# on their next visit). Keep the private key out of the client and out of logs.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com
# Push services the server will POST to (host suffixes). Default: FCM, Mozilla,
# Apple, WNS. Never allow arbitrary hosts — the endpoint URL comes from browsers.
# PUSH_ENDPOINT_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,notify.windows.com
# PUSH_USER_LIMIT_PER_MIN=30        # pushes per user per minute (topic collapses the rest)
# PUSH_TTL_SECONDS=14400            # how long a push service keeps an undelivered push
# PUSH_APP_NAME=Antigravity         # title of "hidden content" pushes
# PUBLIC_URL (above) is used for the link a notification opens.
# Extra CA bundle for reaching push services through a TLS-intercepting proxy.
# PUSH_EXTRA_CA_FILE=/etc/ssl/certs/corporate-ca.pem
# Development/tests only: allow http:// and non-allow-listed push endpoints.
# PUSH_ALLOW_INSECURE_ENDPOINTS=0

# --- observability ---------------------------------------------------------------
# Everything here is optional and off by default. See DEPLOYMENT.md,
# "Observability". LOG_LEVEL accepts trace|debug|info|warn|error|fatal|silent.
#
# OpenTelemetry traces + metrics + logs over OTLP/HTTP. Unset = the SDK is not
# even loaded. Needs the preload (the Docker image always uses it):
#   NODE_OPTIONS="--import ./lib/otel-preload.mjs" npm start
# With the compose `observability` profile: http://lgtm:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=antigravity-discord
# Sample 10% of new traces in production (parent decisions are respected).
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_LOGS_EXPORTER=none            # keep logs on stdout only
# Per-signal endpoints, when traces and metrics go to different collectors:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# OTEL_METRIC_EXPORT_INTERVAL=15000  # ms
# OTEL_SDK_DISABLED=true             # load nothing even if an endpoint is set
#
# Grafana admin password for the compose `observability` profile.
# GRAFANA_ADMIN_PASSWORD=
#
# Error tracking (Sentry protocol: self-hosted GlitchTip or Sentry). Server
# errors (5xx, crashes) are sent with PII scrubbed. SENTRY_BROWSER_DSN is
# public by design (it ships to browsers); use a separate project for it.
# Browser reports are tunnelled through /api/telemetry/errors.
# SENTRY_DSN=
# SENTRY_BROWSER_DSN=
# SENTRY_ENVIRONMENT=production
# Release tag for error reports; the Docker image sets it to the git sha.
# Falls back to GIT_SHA, then SOURCE_COMMIT (set by some PaaS builders).
# APP_RELEASE=
# GIT_SHA=
# SOURCE_COMMIT=
#
# Core Web Vitals from browsers (anonymous; name/value/rating only).
# WEB_VITALS_ENABLED=1
# WEB_VITALS_SAMPLE_RATE=0.25
# RATE_LIMIT_VITALS_PER_MIN=30
#
# Readiness (/api/ready): 503 below this much free disk where uploads or the
# SQLite file live; "low" (still ready) below the warn level.
# READY_DISK_MIN_FREE_MB=256
# READY_DISK_WARN_FREE_MB=1024
# When REDIS_URL is set (see "realtime scale-out" above), /api/ready also
# PINGs Redis/Valkey (redis:// or rediss://).

# --- example bot (scripts/example-bot.mjs) ------------------------------------------
# Only read by the example bot, not by the server.
# API_BASE=http://localhost:3001
# BOT_TOKEN=
